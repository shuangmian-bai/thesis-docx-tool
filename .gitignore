# ===== 个人数据与论文素材（config/ 模块）：一律排除，禁止入库 =====
# 使用者的真实封面信息（姓名、学号等）
config/cover.json

# 学校模板（可能含版权，使用者自备）
config/template.docx

# 论文正文 Markdown 源（每章一个文件）
config/章节/

# 论文插图与签名图（含个人数据）
config/images/

# ===== 生成产物（output/ 模块）：一律排除 =====
output/

# 用户拆解 Word 时生成的图片目录
*_images/

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo

# ===== 操作系统 =====
.DS_Store
Thumbs.db

# ===== IDE =====
.idea/
.vscode/
*.swp

# ===== 临时调试文件 =====
.debug_*.xml
.toc_pass*.json
.toc_prev.json
